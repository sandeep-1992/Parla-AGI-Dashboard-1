# —— Platform owner (admin console at /admin) ——
PLATFORM_ADMIN_USER=platform
PLATFORM_ADMIN_PASSWORD=PlatformAdmin
# Optional stronger signing secret for admin tokens (defaults to PLATFORM_ADMIN_PASSWORD)
PLATFORM_SECRET=

# Seed customer created on first boot if the store is empty
AUTH_USERNAME=admin
AUTH_PASSWORD=Hilton
SALES_ENQUIRY_WEBHOOK_URL=https://engine.auriforce.com/webhook/fetch-sales-enquiry
DEFAULT_TENANT_SLUG=hilton-t5

# Used to load conversation audio and transcripts when a conversation ID is clicked
ELEVENLABS_API_KEY=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
CRON_SECRET=

# Required on Vercel for durable customers + lock-screen push (Upstash Redis / Vercel KV)
# Either naming works:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
