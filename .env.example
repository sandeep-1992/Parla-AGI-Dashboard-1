# Server-side login (never prefix with VITE_ — keeps the password out of the browser bundle)
AUTH_USERNAME=admin
AUTH_PASSWORD=Hilton

# Upstream webhook proxied through /api/enquiries (avoids browser CORS)
SALES_ENQUIRY_WEBHOOK_URL=https://engine.auriforce.com/webhook/fetch-sales-enquiry

# Used to load conversation audio and transcripts when a conversation ID is clicked
ELEVENLABS_API_KEY=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
CRON_SECRET=

# Required for lock-screen / closed-app push on Vercel (Upstash Redis or Vercel KV free tier)
# Without these, alerts still work while the home-screen app is open or recently used.
KV_REST_API_URL=
KV_REST_API_TOKEN=
